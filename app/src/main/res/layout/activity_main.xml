<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wireless Loader DPC"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="कस्टमर फोन: Wireless debugging → Pair device with pairing code"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/etIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IP Address (जैसे 192.168.1.5)"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etPairPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pairing Port (जैसे 37123)"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="6-digit Pairing Code"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etConnectPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Connect Port (Wireless debugging स्क्रीन पर दिखता है)"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. PAIR"
            android:backgroundTint="#38BDF8"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. CONNECT"
            android:backgroundTint="#22D3EE"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnGrant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. GRANT OWNERSHIP"
            android:backgroundTint="#10B981"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Idle"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:background="#1E293B"
            android:padding="14dp"
            android:minHeight="120dp" />
    </LinearLayout>
</ScrollView>
